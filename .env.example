# Copy to .env and fill in. .env is gitignored -- never commit it.

# --- Telegram ---
# From @BotFather: send /newbot, then paste the token it gives you.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric chat IDs allowed to drive this bot.
# Leave empty on first run, send /start to the bot, and it will reply with your ID.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- WorldQuant BRAIN ---
# Same credentials you use to sign in to the BRAIN platform.
BRAIN_CREDENTIAL_EMAIL=
BRAIN_CREDENTIAL_PASSWORD=

# --- Behaviour ---
# How many seconds before session expiry to send the warning. 300 = 5 minutes.
# Temporarily set this to 14000 to test the alert without waiting ~4 hours.
WARN_BEFORE_EXPIRY_SECONDS=300

# How often (seconds) to reconcile the real expiry with our scheduled timers.
# Catches laptop sleep and server-side session invalidation.
SESSION_RECONCILE_SECONDS=600

# Override only if you have a reason to.
BRAIN_API_URL=https://api.worldquantbrain.com
